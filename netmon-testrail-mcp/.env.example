# TestRail API connection
TESTRAIL_URL=https://your-instance.testrail.io
TESTRAIL_USERNAME=qa-user@company.com
TESTRAIL_API_KEY=replace-with-api-key

# NetMon TestRail project configuration
NETMON_PROJECT_ID=1
# Optional. Leave empty for multi-suite projects.
NETMON_SUITE_ID=

# Drafts are stored locally for this POC.
DRAFT_STORE_PATH=.data/testcase-drafts.json